{
  "display_information": {
    "name": "Bank",
    "description": "A tiny currency for our Slack, with a casino, a stock market and a newspaper attached.",
    "background_color": "#1a1a1a",
    "long_description": "Everyone starts with 100 coins. Give them away when someone helps you out: react to their message with a coin emoji, or run /bank give @someone 10. /bank balance, /bank top and /bank history show where you stand.\n\nThen lose them. /bank flip, /bank slots, /bank duel, /bank heist and /bank lottery are the casino, and /bank pool takes bets on whatever the office is arguing about. /bank shop is where coins buy something. /bank buy, /bank sell and /bank portfolio trade real stocks and crypto at real prices with play money. /bank help lists everything.\n\nThe leaderboard, the state of the economy and the casino's hall of shame are at https://labs.shebang.se/bank."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Bank",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/bank",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Give coins, or see what else Bank does",
        "usage_hint": "give @someone 10 for the fix · history · casino · portfolio · help",
        "should_escape": true
      },
      {
        "command": "/bank-balance",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "How many coins you have",
        "should_escape": true
      },
      {
        "command": "/bank-top",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "The leaderboard",
        "should_escape": true
      },
      {
        "command": "/bank-flip",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Double or nothing against the house",
        "usage_hint": "10 · 10 tails",
        "should_escape": true
      },
      {
        "command": "/bank-slots",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Three reels, up to 20 times your stake",
        "usage_hint": "10",
        "should_escape": true
      },
      {
        "command": "/bank-roulette",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Red, black, odd, even, or a number from 0 to 36",
        "usage_hint": "10 red",
        "should_escape": true
      },
      {
        "command": "/bank-blackjack",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Beat the dealer to 21",
        "usage_hint": "10",
        "should_escape": true
      },
      {
        "command": "/bank-duel",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Flip a coin against someone, or anyone, for coins",
        "usage_hint": "@someone 10 · 10",
        "should_escape": true
      },
      {
        "command": "/bank-lottery",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Buy tickets for the daily draw",
        "usage_hint": "5",
        "should_escape": true
      },
      {
        "command": "/bank-buy",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Put coins into a real stock or crypto",
        "usage_hint": "ERIC-B.ST 20",
        "should_escape": true
      },
      {
        "command": "/bank-sell",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Take coins out at today's price",
        "usage_hint": "ERIC-B.ST 20 · ERIC-B.ST all",
        "should_escape": true
      },
      {
        "command": "/bank-portfolio",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "What you hold and what it is worth",
        "should_escape": true
      },
      {
        "command": "/bank-price",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Look a price up",
        "usage_hint": "ERIC-B.ST · AAPL · BTC-USD",
        "should_escape": true
      },
      {
        "command": "/bank-heist",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Get a crew together and rob the house",
        "usage_hint": "10 · join · go",
        "should_escape": true
      },
      {
        "command": "/bank-pool",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Open an office bet with a yes or no answer",
        "usage_hint": "will the demo work? · 10 will the demo work?",
        "should_escape": true
      },
      {
        "command": "/bank-shop",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "What your coins can buy",
        "should_escape": true
      },
      {
        "command": "/bank-bond",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Lock coins away for a week and get them back with interest",
        "usage_hint": "50",
        "should_escape": true
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://labs.shebang.se/bank/auth/install",
      "https://labs.shebang.se/bank/auth/login"
    ],
    "scopes": {
      "user": [
        "openid",
        "profile"
      ],
      "bot": [
        "commands",
        "chat:write",
        "im:write",
        "reactions:read",
        "users:read",
        "emoji:read",
        "team:read",
        "channels:read",
        "channels:join"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://labs.shebang.se/bank/slack/events",
      "bot_events": [
        "reaction_added",
        "app_uninstalled",
        "tokens_revoked",
        "team_join",
        "user_change",
        "channel_created"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://labs.shebang.se/bank/slack/interactions"
    }
  }
}
