{
  "display_information": {
    "name": "Bank",
    "description": "A tiny currency for your Slack. Give coins with a reaction or /bank give.",
    "background_color": "#1a1a1a",
    "long_description": "Everyone in your workspace starts with 100 coins. Give them away when someone helps you out: react to their message with a coin emoji, or run /bank give @someone 10. Check your balance with /bank balance and see the leaderboard with /bank top. Admins can rename the currency, change the starting balance, choose which emoji are worth what, and adjust balances at https://labs.shebang.se/bank."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Bank",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/bank",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Give coins, or see what else Bank does",
        "usage_hint": "give @someone 10 for the fix \u00b7 history \u00b7 casino \u00b7 portfolio \u00b7 help",
        "should_escape": true
      },
      {
        "command": "/bank-balance",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "How many coins you have",
        "should_escape": true
      },
      {
        "command": "/bank-top",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "The leaderboard",
        "should_escape": true
      },
      {
        "command": "/bank-flip",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Double or nothing against the house",
        "usage_hint": "10 \u00b7 10 tails",
        "should_escape": true
      },
      {
        "command": "/bank-slots",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Three reels, up to 20 times your stake",
        "usage_hint": "10",
        "should_escape": true
      },
      {
        "command": "/bank-duel",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Flip a coin against someone for their coins",
        "usage_hint": "@someone 10",
        "should_escape": true
      },
      {
        "command": "/bank-lottery",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Buy tickets for the daily draw",
        "usage_hint": "5",
        "should_escape": true
      },
      {
        "command": "/bank-buy",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Put coins into a real stock or crypto",
        "usage_hint": "ERIC-B.ST 20",
        "should_escape": true
      },
      {
        "command": "/bank-sell",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Take coins out at today's price",
        "usage_hint": "ERIC-B.ST 20 \u00b7 ERIC-B.ST all",
        "should_escape": true
      },
      {
        "command": "/bank-portfolio",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "What you hold and what it is worth",
        "should_escape": true
      },
      {
        "command": "/bank-price",
        "url": "https://labs.shebang.se/bank/slack/commands",
        "description": "Look a price up",
        "usage_hint": "ERIC-B.ST \u00b7 AAPL \u00b7 BTC-USD",
        "should_escape": true
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://labs.shebang.se/bank/auth/install",
      "https://labs.shebang.se/bank/auth/login"
    ],
    "scopes": {
      "user": [
        "openid",
        "profile"
      ],
      "bot": [
        "commands",
        "chat:write",
        "im:write",
        "reactions:read",
        "users:read",
        "emoji:read",
        "team:read",
        "channels:read",
        "channels:join"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://labs.shebang.se/bank/slack/events",
      "bot_events": [
        "reaction_added",
        "app_uninstalled",
        "tokens_revoked",
        "team_join",
        "user_change",
        "channel_created"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
